class Alarma
instance variables
  private episodios : map TiposSAT`IdAlerta to TiposSAT`Episodio := {|->};
  private avisos : map (TiposSAT`IdAlerta * TiposSAT`IdAutoridad) to TiposSAT`Aviso := {|->};
  private siguiente : nat1 := 1;
  inv dom avisos = dunion {{mk_(e, a) | a in set episodios(e).destinatarios}
      | e in set dom episodios} and
    (forall e1, e2 in set dom episodios &
      episodios(e1).abierto and episodios(e2).abierto and
      episodios(e1).quebrada = episodios(e2).quebrada => e1 = e2);
operations
  public pure Activa : TiposSAT`IdQuebrada ==> [TiposSAT`IdAlerta]
  Activa(q) == (for all e in set dom episodios do
    if episodios(e).quebrada = q and episodios(e).abierto then return e;
    return nil);

  public Abrir : TiposSAT`IdQuebrada * set1 of TiposSAT`IdAutoridad ==> ()
  Abrir(q, ds) == (
    -- Materialize the counter value before using it inside an immutable token.
    dcl e : token := mk_token(mk_(<Episodio>, siguiente+0));
    atomic (
      episodios := episodios munion {e |-> mk_TiposSAT`Episodio(q, ds, true)};
      avisos := avisos munion {mk_(e, a) |-> mk_TiposSAT`Aviso(<Pendiente>,0,false)
                               | a in set ds};
      siguiente := siguiente+1
    )
  )
  pre Activa(q) = nil
  post Activa(q) <> nil and
    dom avisos = dom avisos~ union {mk_(Activa(q),a) | a in set ds};

  public Cerrar : TiposSAT`IdQuebrada ==> ()
  Cerrar(q) == (dcl e : token := Activa(q);
    episodios := episodios ++ {e |-> mu(episodios(e), abierto |-> false)})
  pre Activa(q) <> nil
  post Activa(q) = nil and avisos = avisos~;

  public Intentar : TiposSAT`IdAlerta * TiposSAT`IdAutoridad * bool ==> ()
  Intentar(e, a, emitida) == (
    dcl k : token * token := mk_(e,a);
    dcl v : TiposSAT`Aviso := avisos(k);
    if v.estado <> <Confirmada> then
      avisos := avisos ++ {k |-> mk_TiposSAT`Aviso(
        if emitida then <Enviada> else v.estado,
        v.intentos+1, v.intentos+1 >= 3)}
  )
  pre mk_(e,a) in set dom avisos
  post dom avisos = dom avisos~ and episodios = episodios~;

  public Acusar : TiposSAT`IdAlerta * TiposSAT`IdAutoridad ==> ()
  Acusar(e,a) == (dcl k : token * token := mk_(e,a);
    avisos := avisos ++ {k |-> mu(avisos(k), estado |-> <Confirmada>)})
  pre mk_(e,a) in set dom avisos
  post avisos(mk_(e,a)).estado = <Confirmada> and dom avisos = dom avisos~;

  public pure VerAvisos : () ==> map (TiposSAT`IdAlerta * TiposSAT`IdAutoridad) to TiposSAT`Aviso
  VerAvisos() == return avisos;
  public pure VerEpisodios : () ==> map TiposSAT`IdAlerta to TiposSAT`Episodio
  VerEpisodios() == return episodios;
end Alarma
